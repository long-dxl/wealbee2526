{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "supabase/functions/_shared/edge-runtime.d.ts",
    "supabase/functions/**/*.ts"
  ],
  "exclude": ["supabase/functions/**/*.test.ts"]
}
