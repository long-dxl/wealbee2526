# .env mẫu — copy thành kg-stock-vn/.env VÀ toolcrawldata/.env, rồi điền khóa thật.
# KHÔNG commit file .env (đã có trong .gitignore).

# ── Gemini (bộ não) ──
GEMINI_API_KEY=

# ── Supabase WEALBEE (brain đọc/ghi: agents, briefs, market_news, prices_daily...) ──
WEALBEE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
WEALBEE_SUPABASE_KEY=            # service role key

# ── Supabase cho pipeline toolcrawldata (thường TRÙNG với Wealbee ở trên) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=           # service role key

# ── Gửi email brief agent (khi agent bật email_notify) qua Resend ──
RESEND_API_KEY=
EMAIL_FROM=Wealbee <no-reply@wealbee.com>

# ── (tùy chọn) Labeler cũ dùng OpenAI ──
# OPENAI_API_KEY=
