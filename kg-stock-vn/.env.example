# ============================================================
# BIẾN MÔI TRƯỜNG - Knowledge Graph Stock VN
# ============================================================
# Hướng dẫn: Copy file này thành .env rồi điền giá trị thực
#   cp .env.example .env
# ============================================================

# --- GEMINI API (Google AI Studio - MIỄN PHÍ) ---
# Lấy tại: https://aistudio.google.com/app/apikey
# Giới hạn free tier: 15 requests/phút, 1500 requests/ngày
GEMINI_API_KEY=your_gemini_api_key_here

# --- SUPABASE (Lấy từ Dashboard > Settings > API) ---
# Project URL: https://app.supabase.com/project/<project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key (bypass RLS - chỉ dùng server-side, KHÔNG expose ra frontend!)
# Dashboard > Settings > API > service_role (secret)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Anon Key (public - dùng cho client-side nếu cần)
# SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- SERPAPI (Google Search cho AI Agent) ---
# Lấy API key tại: https://serpapi.com/  (free tier ~100 lượt tìm/tháng)
# Cho phép agent chủ động tìm Google để bổ sung/kiểm chứng thông tin kèm nguồn.
SERPAPI_API_KEY=your_serpapi_key_here

# --- VNSTOCK Community API key (nâng rate-limit 20→60 request/phút) ---
# Lấy MIỄN PHÍ tại: https://vnstocks.com/login  (community = 60 req/phút, 3600/giờ)
# agent_config tự gọi vnai.setup_api_key() khi khởi động nếu biến này có giá trị.
VNSTOCK_API_KEY=your_vnstock_community_key_here
